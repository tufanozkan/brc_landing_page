# =============================================================
#  BRC Landing Page — Ortam Değişkenleri Şablonu
#  Bu dosyayı kopyalayıp ".env.local" adıyla kaydedin.
#  Gerçek değerleri girin. Bu dosyayı asla git'e commit etmeyin.
# =============================================================

# ─── SMTP Ayarları (Zorunlu) ──────────────────────────────────
# Hosting panelinizden (cPanel / Plesk vb.) alın.

SMTP_HOST=your_smtp_host
SMTP_PORT=your_smtp_port
SMTP_SECURE=true_or_false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# (İsteğe bağlı) SMTP sertifika doğrulaması varsayılan olarak AÇIKTIR.
# Yalnızca hosting sağlayıcınızın sertifikası geçersizse "false" yapın.
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# Formdan gelen mesajların gönderileceği adres
CONTACT_TO_EMAIL=your_contact_email

# (İsteğe bağlı) Gönderen görünen ad — boş bırakırsanız SMTP_USER kullanılır
CONTACT_FROM_NAME=your_contact_name

# ─── Cloudflare Turnstile (İsteğe Bağlı) ─────────────────────
# https://dash.cloudflare.com → Turnstile → Site ekle
# Tanımlı değilse CAPTCHA devre dışı kalır, site çökmez.

# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key
# TURNSTILE_SECRET_KEY=your_secret_key
# ─── CORS Ayarları ────────────────────────────────────────────
# İletişim API'sine yalnızca bu origin'den gelen istekler kabul edilir.
# Birden fazla domain için ALLOWED_ORIGIN'i virgülle ayırmayın —
# yalnızca tek bir değer girin (www dahil veya hariç).
# Üretimde her ikisini de doldurun; geliştirme ortamında localhost otomatik izin verilir.

# Sitenin tam URL'i (https:// dahil, sonda / olmadan)
NEXT_PUBLIC_SITE_URL=your_site_url

# (İsteğe bağlı) www veya farklı bir subdomain kullanıyorsanız buraya yazın
# ALLOWED_ORIGIN=your_allowed_origin
